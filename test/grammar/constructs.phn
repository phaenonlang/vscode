namespace App;

use Closure;
use Foo\Bar as Baz;

type UserMap = map<Uuid, User>;
type Result<T, E of \Throwable = \RuntimeException> = Ok<T> | Err<E>;

interface Mapper<in TIn, out TOut> extends Base<TIn>
{
    const string NAME = 'mapper';

    map(TIn $in): TOut;

    get(Uuid $id): ?TOut throws NotFound;

    public string $label { get; }
}

final class Box<T of object = object> extends Base<T> implements \IteratorAggregate<int, T>
{
    use Counting { count as protected countAll; }

    const LIMIT = 10;

    const (Countable&Traversable)|null EMPTY = null;

    private readonly map<string, list<Event<T>>> $streams;

    private ?map<string, int> $cache = null;

    public list<T> $items = [];

    private bytes $digest;

    private (string, int) $last;

    public Closure(T): bool $filter;

    public static (Countable&Traversable)|null $shared = null;

    private(set) int $size = 0;

    public string $name {
        get => strtoupper($this->name);
        set(string $value) {
            $this->name = trim($value);
        }
    }

    __construct(
        #[\SensitiveParameter] private readonly class<T> $itemClass,
        private readonly (string, int) $pair,
        private readonly ?list<T> $maybe = null,
        Closure(T, int): bool $pred = null,
        list<T>|null $alt = null,
        array $options = ['depth' => 2, 'sizes' => [1, 2]],
        T ...$rest,
    ) {
        $this->digest = (bytes) random_bytes(16);
    }

    first(list<T> $items): ?T => $items[0] ?? null;

    with(\Closure(T, int): bool $pred): static {
        return $this;
    }

    pairs(): list<(string, int)> => [['a', 1]];

    factory(): Closure(int): bool => fn(int $x): bool => $x > 0;

    kubectl(Closure(string, int=): void $log): Closure(string, string...): (int, string) {
        return static fn(string $stdin, string ...$args): array => [0, $stdin];
    }

    all(): iterable<T> {
        yield from $this->items;
    }

    load(string $path): bytes throws \RuntimeException|\LogicException {
        return (bytes) file_get_contents($path);
    }

    text(bytes $raw): string => mb_check_encoding($raw, 'UTF-8') ? $raw : throw new \ValueError('not valid UTF-8');

    check(mixed $x, string|Id $id): bool {
        if (is_array($x) && array_is_list($x)) {
            return true;
        }
        if ($x === null || $x instanceof User) {
            return false;
        }
        $ok = is_int($x) && is_string($id);
        process($x);

        return $ok;
    }

    public static of<U>(list<U> $rows): Box<U> {
        $id = fn<V>(V $v): V => $v;
        $box = new Box<U>(Repo::class, ['a', 1]);
        $first = first<User>($rows);
        $x = $box->get<Address>(Uuid::nil());
        $y = Collection::of<User>($rows);

        return $box;
    }

    dispatch<TResult of object>(Command<TResult> $command): TResult => $this->bus->handle($command);

    &reference(): array {
        return $this->items;
    }

    protected static &shared(): array => self::$all;

    #[\Override] final public count(): int => count($this->items);

    list(): array => $this->items;

    new(): static => new static();

    public function static(): static => new static();

    public function var(): void {}

    function const(): void {}

    function Closure(): void {}

    public function legacy(): void {
        helper();
    }

    anonymous(): object {
        return new readonly class($this) extends Base {
            __construct(private Box $box) {}

            inner(): int => 1;
        };
    }
}

trait Counting
{
    count(): int => count($this->items);

    abstract protected render(): string;
}

enum Suit: string implements HasLabel
{
    case Hearts = 'H';

    case(): self => self::Hearts;

    label(): string => match ($this) {
        self::Hearts => 'hearts',
    };
}

/** A function keeps PHP's function, with what Phaenon adds to it. */
function headline<T>(Report<T> $report): string => strtoupper($report->title());

/** concurrently and spawn are names like any other: a function, its calls, a method. */
function spawn(string $url): string {
    return fetch($url);
}

function fetchAll(list<string> $urls): list<string> {
    $pages = concurrently([spawn($urls[0]), spawn($urls[1])]);
    $pool->spawn(fn () => fetch($urls[2]));
    $pages = $pages |> array_filter(?, static fn(string $p): bool => $p !== '') |> str_replace(search: "\r", replace: '', subject: ?);

    return Api::concurrently($pages);
}

/** fun and is are names, and as is PHP's: a docblock's list<int> and throws stay comment. */
function plain(): void {
    // fun f(): list<int> in a comment
    $s = 'fun g(): map<string, int> in a string';
    foreach ($xs as $k => $v) {
        $obj->is = $obj->fun() + $obj::spawn + $i<10;
    }
    if ($a < $b && $c > $d) {
        fun(is($a));
    }
    $html = <<<HTML
        <div>fun h(): list<int></div>
        HTML;
}
