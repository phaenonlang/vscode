namespace App\Orders;

/**
 * Outside a type declaration a brace after array is PHP's: the return type ends there and the
 * body begins, on the type's line or the next, after a comment, in a function, a closure, a
 * method with or without function, and a declaration without a body ends at its ;.
 */
function rows(): array {
    return [];
}

function next(): array
{
    return [];
}

function tight(): array{return ['id' => 1];}

function commented(): array /* the rows */ {
    return [];
}

function noted(): ?array // the rows, or none
{
    return null;
}

function either(): array|null {}

function generic<T>(list<T> $items): array {
    return $items;
}

function thrown(): array throws \RuntimeException {
    return [];
}

$closure = function (array $rows) use ($limit): array {
    return array_slice($rows, 0, $limit);
};

$static = static function (): array{
    return [];
};

$arrow = fn(array $rows): array => [...$rows, ['id' => 1]];

interface Repository
{
    all(): array;

    find(int $id): ?array;

    public function legacy(): array;
}

abstract class Base implements Repository
{
    public array $rows = [];

    const array EMPTY = [];

    abstract protected load(): array;

    all(): array {
        return $this->rows;
    }

    find(int $id): ?array
    {
        return $this->rows[$id] ?? null;
    }

    public function legacy(): array{
        return ['id' => 1, 'name' => 'a'];
    }

    static make(): array /* fresh */ {
        return [];
    }

    none(): array {}

    first<T>(list<T> $items): array => [$items[0]];

    anonymous(): object {
        return new class {
            rows(): array {
                return [];
            }
        };
    }
}

enum Status: string
{
    case Open = 'open';

    labels(): array {
        return ['open' => 'Open'];
    }
}
