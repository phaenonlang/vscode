{
  "name": "Phaenon",
  "scopeName": "source.phaenon",
  "fileTypes": [
    "phn"
  ],
  "comment": "A Phaenon file is PHP code from byte 0: the PHP code grammar (source.php, which VS Code and JetBrains IDEs ship) without the text.html.php wrapper that waits for an open tag, plus what Phaenon adds: type parameters and arguments, list, map, bytes, tuple and closure types, throws, type aliases, expression bodies, and methods declared without a keyword. A method is told from a call only by where it stands, so the class-like declarations are this grammar's own rules, injected ahead of PHP's, and their bodies hold the member rules (#class-members) that apply nowhere else. The rules reuse PHP's scope names wherever PHP has the construct, so themes colour them as PHP.",
  "patterns": [
    {
      "include": "source.php"
    }
  ],
  "injections": {
    "L:source.phaenon - comment - string - meta.use.php": {
      "patterns": [
        {
          "include": "#class"
        },
        {
          "include": "#interface"
        },
        {
          "include": "#trait"
        },
        {
          "include": "#enum"
        },
        {
          "include": "#function"
        },
        {
          "include": "#generic-closure"
        },
        {
          "include": "#type-alias"
        },
        {
          "include": "#generic-new"
        },
        {
          "include": "#generic-call"
        },
        {
          "include": "#nullable-generic"
        },
        {
          "include": "#generic-type"
        },
        {
          "include": "#bytes"
        },
        {
          "include": "#placeholder"
        }
      ]
    }
  },
